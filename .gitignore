.DS_Store
.claude/
DerivedData/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
# Xcode workspace's derived SwiftPM state; local Swift package lockfiles stay tracked.
# The app's Package.resolved is tracked too: a fresh resolve otherwise pulls swift-issue-reporting 2.x
# beside xctest-dynamic-overlay, and the test build's two IssueReporting frameworks collide.
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
import-inbox/

# Local TestFlight archives, exports, recovery state, and generated notes.
build/testflight/
